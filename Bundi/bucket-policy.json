{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ReadWriteInImagesFolder",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::739874238091:root"
            },
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::YOUR_S3_BUCKET_NAME/images/*"
        },
        {
            "Sid": "PublicReadGetObject",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::process.env.AWS_S3_BUCKET/images/*"
        }
    ]
}