rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidPhoneNumber() {
      return request.resource.data.phoneNumber.matches('^\\+[1-9]\\d{1,14}$');
    }

    function isValidUserData() {
      let data = request.resource.data;
      return isValidPhoneNumber()
        && data.createdAt is timestamp
        && data.lastLogin is timestamp
        && data.isActive is bool;
    }

    // Users collection
    match /users/{userId} {
      // Allow read if the document ID matches the phone number in the document
      allow read: if request.auth == null && resource.data.phoneNumber == userId;
      
      // Allow create if the data is valid and the document ID matches the phone number
      allow create: if request.auth == null 
        && isValidUserData() 
        && userId == request.resource.data.phoneNumber;
      
      // Allow update if the document ID matches the phone number
      allow update: if request.auth == null 
        && userId == resource.data.phoneNumber
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastLogin', 'isActive']);
      
      // Disallow deletion
      allow delete: if false;
    }

    // User chats collection
    match /userChats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() 
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // Group messages collection
    match /groups/{groupId}/messages/{messageId} {
      allow read: if isAuthenticated() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      allow create: if isAuthenticated() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // OTP attempts collection
    match /otp_attempts/{attemptId} {
      allow create: if isValidOTPAttempt();
      allow read: if isAuthenticated() 
        && (resource.data.phoneNumber == request.auth.token.phone_number
            || request.auth.token.admin == true);
      allow update: if isAuthenticated() 
        && (resource.data.phoneNumber == request.auth.token.phone_number
            || request.auth.token.admin == true)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['verified', 'attempts']);
      allow delete: if false;
    }

    // SMS messages collection
    match /sms_messages/{messageId} {
      allow create: if isValidSMSMessage();
      allow read: if isAuthenticated() 
        && (resource.data.to == request.auth.token.phone_number
            || request.auth.token.admin == true);
      allow update: if isAuthenticated() 
        && (resource.data.to == request.auth.token.phone_number
            || request.auth.token.admin == true)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'sendgridResponse', 'error']);
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}