rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is a participant in a conversation
    function isParticipant(conversationId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
      );
    }

    // Users collection - allow reading profiles and writing to own profile
    match /users/{userId} {
      allow read: if isAuthenticated();  // Allow reading any user profile
      allow write: if isOwner(userId);   // Only allow writing to own profile
    }

    // User's friends subcollection
    match /users/{userId}/friends/{friendId} {
      allow read: if isAuthenticated();  // Allow reading friend lists
      allow write: if isOwner(userId);   // Only allow modifying own friend list
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
    }

    // Messages subcollection
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid
      );
    }

    // Friend requests collection
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.from == request.auth.uid || 
        resource.data.to == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.from == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.to == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.from == request.auth.uid || 
        resource.data.to == request.auth.uid
      );
    }

    // Global upload logs - allow reading for duplicate detection
    match /global_upload_logs/{fileHash} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Perceptual hashes - allow reading for similarity detection
    match /perceptual_hashes/{fileHash} {
      allow read: if isAuthenticated();
      // Only Cloud Functions should write to this
      allow write: if false;
    }

    // Similarity groups - allow reading for duplicate detection
    match /similarity_groups/{fileHash} {
      allow read: if isAuthenticated();
      // Only Cloud Functions should write to this
      allow write: if false;
    }

    // Group counts - allow reading for duplicate detection
    match /group_counts/{groupId} {
      allow read: if isAuthenticated();
      // Only Cloud Functions should write to this
      allow write: if false;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
