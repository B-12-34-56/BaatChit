rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isValidPhoneNumber() {
      return request.resource.data.phoneNumber.matches('^\\+[1-9]\\d{1,14}$');
    }

    function isValidEmail() {
      return request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    function isValidUserData() {
      let data = request.resource.data;
      return (isValidPhoneNumber() || isValidEmail())
        && data.createdAt is timestamp
        && data.lastLogin is timestamp
        && data.isActive is bool;
    }

    function isValidFriendRequest() {
      let data = request.resource.data;
      return data.senderId == request.auth.uid
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is timestamp;
    }

    // Users collection
    match /users/{userId} {
      // Allow authenticated users to read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow authenticated users to update their own document (limited fields)
      allow update: if isAuthenticated() 
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastLogin', 'isActive', 'displayName', 'avatar', 'phoneNumber', 'email', 'friends', 'friendRequests']);
      
      // Allow creation through Cloud Functions only
      allow create: if request.auth != null 
        && (request.auth.token.phoneNumber == request.resource.data.phoneNumber
            || request.auth.token.email == request.resource.data.email)
        && isValidUserData();
      
      // Don't allow client-side deletion
      allow delete: if false;
    }

    // Friend requests collection
    match /friendRequests/{requestId} {
      // Allow users to create friend requests
      allow create: if isAuthenticated() 
        && isValidFriendRequest();
      
      // Allow users to read friend requests they're involved in
      allow read: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      
      // Allow users to update friend requests they're involved in
      allow update: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']);
      
      // Don't allow deletion
      allow delete: if false;
    }

    // User chats collection
    match /userChats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() 
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() 
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // Group messages collection
    match /groups/{groupId}/messages/{messageId} {
      allow read: if isAuthenticated() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      allow create: if isAuthenticated() 
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // OTP attempts collection
    match /otp_attempts/{attemptId} {
      allow create: if isValidOTPAttempt();
      allow read: if isAuthenticated() 
        && (resource.data.phoneNumber == request.auth.token.phone_number
            || request.auth.token.admin == true);
      allow update: if isAuthenticated() 
        && (resource.data.phoneNumber == request.auth.token.phone_number
            || request.auth.token.admin == true)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['verified', 'attempts']);
      allow delete: if false;
    }

    // SMS messages collection
    match /sms_messages/{messageId} {
      allow create: if isValidSMSMessage();
      allow read: if isAuthenticated() 
        && (resource.data.to == request.auth.token.phone_number
            || request.auth.token.admin == true);
      allow update: if isAuthenticated() 
        && (resource.data.to == request.auth.token.phone_number
            || request.auth.token.admin == true)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'sendgridResponse', 'error']);
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}