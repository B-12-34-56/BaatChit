{
  "expo": {
    "name": "bundikitab",
    "slug": "bundikitab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bundikitab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bundikitab.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Bundi/Kitab to access your camera to take photos and videos",
        "NSPhotoLibraryUsageDescription": "Allow Bundi/Kitab to access your photos to upload images",
        "NSMicrophoneUsageDescription": "Allow Bundi/Kitab to access your microphone for video messages",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bundikitab.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bundi/Kitab to access your photos to upload images",
          "cameraPermission": "Allow Bundi/Kitab to access your camera to take photos and videos"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4dbc1c92-1eb4-43ce-baa2-4542d002b8ae"
      },
      "uploadApiUrl": "YOUR_UPLOAD_API_URL",
      "presignApiUrl": "http://localhost:4000"
    }
  }
}
