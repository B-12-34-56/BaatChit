# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Configuration
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com/images/

# API Gateway URLs and Keys
AWS_UPLOAD_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/Deployment/upload-image
AWS_UPLOAD_API_KEY=your_upload_api_key
AWS_GETTAG_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/Stage1/get-tag
AWS_GETTAG_API_KEY=your_gettag_api_key
AWS_BLOCKIMAGE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/Stage1/block-image
AWS_BLOCKIMAGE_API_KEY=your_blockimage_api_key

# DynamoDB Configuration
AWS_DYNAMODB_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/Stage1
AWS_GETTAG_API_GATEWAY=https://your-api-id.execute-api.us-east-1.amazonaws.com/GetTag1

# Cognito Configuration
AWS_COGNITO_USER_POOL_ID=your_user_pool_id
AWS_COGNITO_USER_POOL_CLIENT_ID=your_user_pool_client_id
AWS_COGNITO_IDENTITY_POOL_ID=your_identity_pool_id

# Lambda Environment Variables
AWS_REGION=us-east-1
AWS_BUCKET=your_s3_bucket_name
S3_BUCKET=your_s3_bucket_name 