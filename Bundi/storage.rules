rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the file
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own files in user_uploads
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() 
        && isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024 // 5MB max file size
        && request.resource.contentType.matches('image/.*'); // Only allow images
    }

    // Allow authenticated access to all other paths
    match /{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
  }
} 