{
  "name": "bundikitab-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "migrate-users": "ts-node scripts/migrateUsers.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:otp": "detox test -c ios.sim.debug",
    "test:otp:android": "detox test -c android.emu.debug",
    "build:ios": "detox build -c ios.sim.debug",
    "build:android": "detox build -c android.emu.debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/native-stack": "^7.3.14",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "expo": "~53.0.10",
    "expo-auth-session": "~6.2.0",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.6",
    "expo-file-system": "~16.0.8",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.2.0",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-random": "^14.0.1",
    "expo-router": "~5.0.7",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.8",
    "expo-web-browser": "~14.1.6",
    "firebase": "^11.9.1",
    "lodash": "^4.17.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-native": "0.79.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-otp-entry": "^1.8.4",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-toast-message": "^2.3.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "twilio": "^5.7.0",
    "use-debounce": "^10.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/aria-query": "^5.0.4",
    "@types/body-parser": "^1.19.6",
    "@types/bonjour": "^3.5.13",
    "@types/caseless": "^0.12.5",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/detox": "^18.1.3",
    "@types/eslint": "^9.6.1",
    "@types/eslint-scope": "^8.3.0",
    "@types/estree": "^1.0.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ms": "^2.1.0",
    "@types/prettier": "^3.0.0",
    "@types/react": "~19.0.10",
    "@types/request": "^2.48.12",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/triple-beam": "^1.3.5",
    "@types/trusted-types": "^2.0.7",
    "detox": "^20.39.0",
    "eslint": "^9.28.0",
    "eslint-config-expo": "^9.2.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^13.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "detox": {
    "testRunner": "jest",
    "runnerConfig": "e2e/config.json",
    "apps": {
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/BaatChit.app",
        "build": "xcodebuild -workspace ios/BaatChit.xcworkspace -scheme BaatChit -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      },
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 14"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_3a_API_30_x86"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios.debug"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android.debug"
      }
    }
  }
}
