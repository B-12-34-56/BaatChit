rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAllowedImage() {
      return request.resource.contentType.matches('image/jpeg') || request.resource.contentType.matches('image/png');
    }
    function isAllowedPdf() {
      return request.resource.contentType.matches('application/pdf');
    }
    function isAllowedMime() {
      return isAllowedImage() || isAllowedPdf();
    }
    function isFileSizeOk() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }
    function isAdminUser() {
      return request.auth.uid in ['adminUid1', 'adminUid2']; // Replace with your admin UIDs
    }
    function isServiceAccount() {
      return request.auth.token.firebase.sign_in_provider == 'serviceAccount';
    }

    // --- 1. User Avatars ---
    match /avatars/{uid}/{filename} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && request.auth.uid == uid && isFileSizeOk() && isAllowedImage();
    }

    // --- 2. Chat Attachments ---
    match /chats/{chatId}/messages/{messageId}/{filename} {
      allow read, write, delete: if isAuthenticated() && isFileSizeOk() && isAllowedMime();
      // Membership and sender checks must be enforced in your app/backend
    }

    // --- 3. Room Files ---
    match /rooms/{roomId}/attachments/{filename} {
      allow read, write, delete: if isAuthenticated() && isFileSizeOk() && isAllowedMime();
      // Membership and admin checks must be enforced in your app/backend
    }

    // --- 4. Admin Backups ---
    match /admin/backups/{filename} {
      allow read, write: if isServiceAccount() || isAdminUser();
    }
  }
}