rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //------------------------------------------------------------------------------------------------
    // 1. Helper Functions
    //------------------------------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    //------------------------------------------------------------------------------------------------
    // 2. USERS COLLECTION
    //------------------------------------------------------------------------------------------------

    match /users/{userId} {
      // 2.1 Read: Any authenticated user may read any public profile data
      allow read: if isAuthenticated();

      // 2.2 Create: Only the user themself may create their own profile,
      //     and must supply exactly these fields with correct values.
      //     - uid: must equal auth.uid
      //     - email: must equal auth.token.email
      //     - displayName: nonempty string (max 50 chars)
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    // Enforce displayName is a nonempty string ≤ 50 chars
                    && (request.resource.data.displayName is string)
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 50;

      // 2.3 Update: Only the owner may update their own profile. We explicitly:
      //     • Block changing uid or email
      //     • Validate displayName if present
      //     • Validate friends only if present (must be a list)
      allow update: if isOwner(userId)
                    // Disallow any attempt to modify uid or email
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email'])
                    // If displayName is being updated, enforce string length rules
                    && (
                         !request.resource.data.keys().hasAny(['displayName'])
                         || (
                              request.resource.data.displayName is string
                              && request.resource.data.displayName.size() > 0
                              && request.resource.data.displayName.size() <= 50
                            )
                       )
                    // If friends is being updated, ensure it is an array (list)
                    && (
                         !request.resource.data.keys().hasAny(['friends'])
                         || (
                              request.resource.data.friends is list
                              && request.resource.data.friends.size() <= 5000  // optional max size
                            )
                       );

      // 2.4 Delete: Disallowed for now
      allow delete: if false;
    }

    //------------------------------------------------------------------------------------------------
    // 3. FRIEND REQUESTS COLLECTION
    //------------------------------------------------------------------------------------------------

    match /friendRequests/{requestId} {
  // Read: Only the sender or recipient can read
  allow read: if request.auth != null &&
    (resource.data.from == request.auth.uid || resource.data.receiverId == request.auth.uid);

  // Create: Only the sender can create, must be 'pending', no self-requests
  allow create: if request.auth != null &&
    request.resource.data.keys().hasOnly(['from', 'receiverId', 'status', 'timestamp', 'createdAt']) &&
    request.resource.data.from == request.auth.uid &&
    request.resource.data.from != request.resource.data.receiverId &&
    request.resource.data.status == 'pending' &&
    (
      (request.resource.data.timestamp is timestamp) ||
      (request.resource.data.createdAt is timestamp)
    );

  // Update: Only the recipient can accept/reject, must be 'pending' before, and only allowed fields can change
  allow update: if request.auth != null &&
    resource.data.receiverId == request.auth.uid &&
    resource.data.status == 'pending' &&
    (
      // Accept
      (
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']) &&
        request.resource.data.acceptedAt == request.time
      )
      ||
      // Reject
      (
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedAt']) &&
        request.resource.data.rejectedAt == request.time
      )
    );

  // Delete: Either sender or recipient can delete/cancel
  allow delete: if request.auth != null &&
    (resource.data.from == request.auth.uid || resource.data.receiverId == request.auth.uid);
}

    //------------------------------------------------------------------------------------------------
    // 4. CONVERSATIONS COLLECTION
    //------------------------------------------------------------------------------------------------

    match /conversations/{conversationId} {
      // 4.1 Helper: check if auth.uid is a member of the existing `participants` list
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      // 4.2 Helper: check if auth.uid is in the new `participants` list on create
      function willBeParticipant() {
        return request.auth.uid in request.resource.data.participants;
      }

      // 4.3 Read: Only participants can read a conversation doc
      allow read: if isAuthenticated() && isParticipant();

      // 4.4 Create: Only authenticated users can create a 1:1 conversation, with exactly two participants,
      //      and server sends createdAt timestamp.
      allow create: if isAuthenticated()
                    // Must supply exactly these keys
                    && request.resource.data.keys().hasAll(['participants', 'createdAt'])
                    && request.resource.data.participants is list
                    // Exactly two UIDs (1:1 chat)
                    && request.resource.data.participants.size() == 2
                    // I must be one of those two
                    && willBeParticipant()
                    // createdAt must be server timestamp
                    && request.resource.data.createdAt == request.time
                    // Each participant entry must be a valid string UID
                    && request.resource.data.participants.size() == 2;

      // 4.5 Update: Only participants may update their own conversation. We forbid changing `participants`.
      //      If updating `lastMessageTime`, enforce it == server timestamp.
      allow update: if isAuthenticated()
                    && isParticipant()
                    // Cannot change participants array
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
                    // If lastMessageTime is present in diff, it must be server time
                    && (
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageTime'])
                         || request.resource.data.lastMessageTime == request.time
                       );

      // 4.6 Delete: Not allowed (we do soft-archive instead)
      allow delete: if false;

      //------------------------------------------------------------------------------------------------
      // 4.7 MESSAGES SUBCOLLECTION
      //------------------------------------------------------------------------------------------------

      match /messages/{messageId} {
        // 4.7.1 Read: Only participants of the parent conversation may read messages
        allow read: if isAuthenticated()
                      && get(/databases/$(database)/documents/conversations/$(conversationId))
                           .data.participants.hasAny([request.auth.uid]);

        // 4.7.2 Create: Only conversation participants can create messages
        allow create: if isAuthenticated()
                      && get(/databases/$(database)/documents/conversations/$(conversationId))
                           .data.participants.hasAny([request.auth.uid])
                      && request.resource.data.keys().hasAll(['senderUid', 'text', 'timestamp', 'type'])
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.type in ['text', 'image']
                      && (
                           (request.resource.data.type == 'text'
                              && request.resource.data.text is string
                              && request.resource.data.text.size() > 0
                              && request.resource.data.text.size() <= 5000)
                           ||
                           (request.resource.data.type == 'image'
                              && request.resource.data.text is string
                              && request.resource.data.text.size() <= 5000)
                         );

        // 4.7.3 Update: Only the original sender may edit their message. They can change:
        //       text, edited (bool), editedAt (serverTimestamp), deleted (bool), type.
        //       We do NOT allow the sender to toggle `read` or `delivered` here.
        allow update: if isAuthenticated()
                      && resource.data.senderUid == request.auth.uid
                      // Must only touch these keys
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                           ['text', 'edited', 'editedAt', 'deleted', 'type']
                         )
                      // If `edited` flag is present, require `editedAt == request.time`
                      && (
                           !request.resource.data.keys().hasAny(['edited'])
                           || (
                                request.resource.data.edited == true
                                && request.resource.data.editedAt == request.time
                              )
                         );

        // 4.7.4 Delete: Hard deletes are disallowed—use `deleted` flag instead.
        allow delete: if false;
      }
    }

    //------------------------------------------------------------------------------------------------
    // 5. NOTIFICATIONS COLLECTION
    //------------------------------------------------------------------------------------------------

    match /notifications/{userId} {
      // 5.1 Read: A user may only read their own notifications
      allow read: if isOwner(userId);

      // 5.2 Create: Any authenticated user (including your backend Cloud Functions) may create a notification,
      //      but we enforce a specific schema:
      //        { title: string, body: string, senderUid: string, timestamp: serverTimestamp, read: bool=false }
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['title', 'body', 'senderUid', 'timestamp', 'read'])
                    // Validate types/lengths
                    && (request.resource.data.title is string) 
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 100
                    && (request.resource.data.body is string) 
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 1000
                    && request.resource.data.senderUid is string
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.read == false;  // new notifications start unread

      // 5.3 Update: The user may only mark "read" → true. We enforce:
      //       • Only the `read` and `readAt` keys may change
      //       • If `read == true`, then `readAt == serverTimestamp`
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
                    && request.resource.data.read == true
                    && request.resource.data.readAt == request.time;

      // 5.4 Delete: Each user may delete their own notifications
      allow delete: if isOwner(userId);
    }

    //------------------------------------------------------------------------------------------------
    // 6. USER PRESENCE / STATUS COLLECTION
    //------------------------------------------------------------------------------------------------

    match /status/{userId} {
      // 6.1 Read: Any authenticated user can read someone's presence (online/offline)
      allow read: if isAuthenticated();

      // 6.2 Write: Only the owner can update their own presence. Enforce schema:
      //      { online: bool, lastSeen: serverTimestamp }
      allow write: if isOwner(userId)
                   && request.resource.data.keys().hasAll(['online', 'lastSeen'])
                   && request.resource.data.online is bool
                   && request.resource.data.lastSeen == request.time;
    }

    //------------------------------------------------------------------------------------------------
    // 7. BLOCK LIST (UNDER /users/{userId}/blocked/{blockedId})
    //------------------------------------------------------------------------------------------------

    match /users/{userId}/blocked/{blockedId} {
      // 7.1 Only the owner of the block list may read/write here
      allow read, write: if isOwner(userId)
                        // Cannot block yourself
                        && blockedId != request.auth.uid;
      // (Optionally, enforce { blockedAt: serverTimestamp } in the write schema.)
    }

    //------------------------------------------------------------------------------------------------
    // 8. USER SETTINGS (UNDER /users/{userId}/settings/{doc})
    //------------------------------------------------------------------------------------------------

    match /users/{userId}/settings/{doc=**} {
      // 8.1 Only the owner may read/write their own settings.
      allow read, write: if isOwner(userId);
      // (If you know exact setting keys, you can validate them here as well.)
    }
  }
}
