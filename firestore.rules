rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any authenticated user to read/write the top-level 'rooms' collection:
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;

      // Allow any authenticated user to read/write messages inside a room
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }

      // Also allow any authenticated user to read/write the members subcollection
      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }
    }

    // If you have a "conversations" collection, allow everything there as well:
    match /conversations/{convoId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Loosen friendRequests completely:
    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Loosen users collection so clients can read/write their own profile freely:
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // If you have a userChats or rooms subcollection under userChats, open that too:
    match /userChats/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
