rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isAdmin(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.role == "admin";
    }

    // --- 1. USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'bio', 'createdAt', 'displayName', 'email', 'emailVerified', 'friends', 'isOnline', 'lastActive', 'lastSeen', 'photoURL', 'status', 'uid'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.displayName is string)
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50;

      allow update: if isOwner(userId)
        // Cannot change uid, email, or createdAt
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'createdAt'])
        // If displayName is being updated, enforce string length rules
        && (
          !request.resource.data.keys().hasAny(['displayName']) ||
          (
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 50
          )
        )
        // If friends is being updated, ensure it is an array and not too large
        && (
          !request.resource.data.keys().hasAny(['friends']) ||
          (
            request.resource.data.friends is list &&
            request.resource.data.friends.size() <= 5000
          )
        )
        // If isOnline is being updated, must be boolean
        && (
          !request.resource.data.keys().hasAny(['isOnline']) ||
          (request.resource.data.isOnline is bool)
        )
        // If lastActive or lastSeen is being updated, must be server timestamp
        && (
          !request.resource.data.keys().hasAny(['lastActive']) ||
          request.resource.data.lastActive == request.time
        )
        && (
          !request.resource.data.keys().hasAny(['lastSeen']) ||
          request.resource.data.lastSeen == request.time
        );

      allow delete: if false;
    }

    // --- 2. FRIEND REQUESTS COLLECTION ---
    match /friendRequests/{requestId} {
      // Read: Only the sender or recipient can read
      allow read: if isAuthenticated() &&
        (resource.data.from == request.auth.uid || resource.data.receiverId == request.auth.uid);

      // Create: Only the sender can create, must be 'pending', no self-requests
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['from', 'receiverId', 'status', 'timestamp'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.receiverId
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && request.resource.data.status == "pending"
        && request.resource.data.timestamp == request.time;

      // Update: Only the recipient can accept/reject, must be 'pending' before, and only allowed fields can change
      allow update: if isAuthenticated()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == "pending"
        && (
          (
            request.resource.data.status == "accepted" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']) &&
            request.resource.data.acceptedAt == request.time
          ) ||
          (
            request.resource.data.status == "rejected" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedAt']) &&
            request.resource.data.rejectedAt == request.time
          )
        );

      // Delete: Either sender or recipient can delete/cancel
      allow delete: if isAuthenticated() &&
        (resource.data.from == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // --- 3. CONVERSATIONS COLLECTION ---
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function willBeParticipant() {
        return request.auth.uid in request.resource.data.participants;
      }

      allow read: if isAuthenticated() && isParticipant();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'lastMessage', 'lastMessageTime'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && willBeParticipant()
        && request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated() && isParticipant()
        // Cannot change participants array
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
        // If lastMessageTime is present, must be server time
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageTime']) ||
          request.resource.data.lastMessageTime == request.time
        )
        // If lastMessage is present, must be a string or null
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage']) ||
          (request.resource.data.lastMessage is string || request.resource.data.lastMessage == null)
        );

      allow delete: if false;

      // --- MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);

        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.timestamp == request.time
          && request.resource.data.type in ["text", "image"]
          && (
            (request.resource.data.type == "text"
              && request.resource.data.keys().hasOnly(['senderUid', 'timestamp', 'type', 'text'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000
            ) ||
            (request.resource.data.type == "image"
              && (
                (request.resource.data.keys().hasOnly(['senderUid', 'timestamp', 'type', 'imageUrl'])
                  && request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.size() > 0
                ) ||
                (request.resource.data.keys().hasOnly(['senderUid', 'timestamp', 'type', 'attachments'])
                  && request.resource.data.attachments is list
                  && request.resource.data.attachments.size() > 0
                  && request.resource.data.attachments[0] is string
                )
              )
            )
          );

        allow update: if isAuthenticated()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt', 'deleted', 'type'])
          && (
            !request.resource.data.keys().hasAny(['edited']) ||
            (request.resource.data.edited == true && request.resource.data.editedAt == request.time)
          );

        allow delete: if false;
      }
    }

    // --- 4. ROOMS COLLECTION ---
    match /rooms/{roomId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['createdAt', 'name', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.name is string)
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      allow update: if isAuthenticated()
        && (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin(roomId)
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid'])
        && (
          !request.resource.data.keys().hasAny(['name']) ||
          (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100)
        );

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // --- MEMBERS SUBCOLLECTION ---
      match /members/{memberUid} {
        allow read: if isAuthenticated() && isMember(roomId);

        allow create: if isAuthenticated()
          && (
            // User joining themselves
            (memberUid == request.auth.uid
              && !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(memberUid))
              && request.resource.data.keys().hasOnly(['joinedAt', 'role'])
              && request.resource.data.joinedAt == request.time
              && request.resource.data.role == "member"
            ) ||
            // Owner or admin adding/updating a member
            (
              (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid || isAdmin(roomId))
              && request.resource.data.keys().hasOnly(['joinedAt', 'role'])
              && (request.resource.data.role == "member" || request.resource.data.role == "admin")
              && (
                !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(memberUid)) ||
                request.resource.data.joinedAt == resource.data.joinedAt
              )
            )
          );

        allow update: if isAuthenticated()
          && (
            (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid || isAdmin(roomId))
            && request.resource.data.keys().hasOnly(['role'])
            && (request.resource.data.role == "member" || request.resource.data.role == "admin")
          );

        allow delete: if isAuthenticated()
          && (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid ||
            isAdmin(roomId)
          );
      }

      // --- MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isMember(roomId);

        allow create: if isAuthenticated()
          && isMember(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000) ||
            (request.resource.data.attachments is list && request.resource.data.attachments.size() > 0 && request.resource.data.attachments[0] is string)
          )
          && request.resource.data.keys().hasOnly(['attachments', 'createdAt', 'editedAt', 'senderName', 'senderUid', 'text']);

        allow update: if isAuthenticated()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'editedAt', 'attachments'])
          && (
            !request.resource.data.keys().hasAny(['editedAt']) ||
            request.resource.data.editedAt == request.time
          );

        allow delete: if false;
      }
    }

    // --- 5. userChats COLLECTION ---
    // No rules for userChats until data structure is defined

  }
}
