// IMPORTANT: After editing this file, publish your rules in the Firebase Console or with the Firebase CLI.
// See: https://console.firebase.google.com/ or run `firebase deploy --only firestore:rules`

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1) RULES FOR THE "users" COLLECTION (login/profile data)
    match /users/{userId} {
      // Anyone signed-in can create their own user document
      allow create: if request.auth != null;
      
      // Only the authenticated user whose UID == userId may read, update, or delete their own document
      allow read, update, delete: if request.auth != null
                                && request.auth.uid == userId;
    }

    // 2) RULES FOR THE "userChats" COLLECTION (chat rooms or threads)
    // Each chat doc must contain a field "participants" (array of UIDs).
    match /userChats/{chatId} {
      // CREATE: allowed if signed-in AND auth.uid is in the submitted participants array
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // READ: only if signed-in AND auth.uid is in the existing participants array
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      // UPDATE & DELETE: only if signed-in AND auth.uid is still in the existing participants array
      allow update, delete: if request.auth != null
                            && request.auth.uid in resource.data.participants;

      // 3) RULES FOR "messages" SUBCOLLECTION INSIDE EACH CHAT
      match /messages/{messageId} {
        // READ: signed-in participant of the parent chat
        allow read: if request.auth != null
                    && request.auth.uid in 
                       get(/databases/$(database)/documents/userChats/$(chatId)).data.participants;

        // CREATE: signed-in, must be a participant, senderUid must equal auth.uid, createdAt must equal request.time
        allow create: if request.auth != null
                      && request.auth.uid in 
                         get(/databases/$(database)/documents/userChats/$(chatId)).data.participants
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.createdAt == request.time;

        // UPDATE & DELETE: only the original sender may modify or delete their own message
        allow update, delete: if request.auth != null
                              && resource.data.senderUid == request.auth.uid;
      }
    }

    // 4) RULES FOR THE "friendRequests" COLLECTION
    match /friendRequests/{requestId} {
      // CREATE: Only authenticated users can create a request where they are the sender
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      // READ: Only the sender or recipient can read the request, and only if 'from' and 'to' fields exist
      allow read: if request.auth != null && (("from" in resource.data && resource.data.from == request.auth.uid) || ("to" in resource.data && resource.data.to == request.auth.uid));
      // UPDATE: Only the recipient can accept/reject, only the sender can cancel
      allow update: if request.auth != null && (
        (resource.data.to == request.auth.uid) ||
        (resource.data.from == request.auth.uid)
      );
      // DELETE: Only the sender or recipient can delete
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload (read/write) any file path if authenticated
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
