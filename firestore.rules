rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1) USERS COLLECTION
    match /users/{userId} {
      // Anyone signed-in can create their own user document
      allow create: if request.auth != null;
      
      // Users can read any user document (for friend search, etc.)
      allow read: if request.auth != null;
      
      // Combined update rule
      allow update: if request.auth != null && (
        // User updating their own profile
        request.auth.uid == userId ||
        // Someone updating ONLY the friends array
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
          (request.auth.uid in resource.data.friends || 
           request.auth.uid in request.resource.data.friends ||
           resource.data.friends == null)
        )
      );
      
      // Only the user themselves can delete their profile
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 1a) USER CHATS COLLECTION
    match /userChats/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2) CONVERSATIONS COLLECTION
    match /conversations/{conversationId} {
      // CREATE: allowed if signed-in AND auth.uid is in the submitted participants array
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      
      // READ: only if signed-in AND auth.uid is in the existing participants array
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      
      // UPDATE: Allow participants to update (for lastMessage, lastMessageTime, etc.)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      
      // DELETE: only if signed-in AND auth.uid is in the existing participants array
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      
      // 3) MESSAGES SUBCOLLECTION - SIMPLIFIED AND MORE PERMISSIVE
      match /messages/{messageId} {
        // READ: signed-in participant of the parent conversation
        allow read: if request.auth != null
                    && request.auth.uid in 
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // CREATE: Very permissive - just check if user is a participant
        allow create: if request.auth != null
                      && request.auth.uid in 
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // UPDATE: Allow the sender to update their own messages
        allow update: if request.auth != null
                      && request.auth.uid in 
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && (
                        (resource.data.senderId == request.auth.uid) ||
                        (resource.data.senderUid == request.auth.uid) ||
                        (resource.data.uid == request.auth.uid)
                      );
        
        // DELETE: Allow sender to delete their own messages
        allow delete: if request.auth != null
                      && (
                        (resource.data.senderId == request.auth.uid) ||
                        (resource.data.senderUid == request.auth.uid) ||
                        (resource.data.uid == request.auth.uid)
                      );
      }
    }
    
    // 4) FRIEND REQUESTS COLLECTION
    match /friendRequests/{requestId} {
      // CREATE: Only authenticated users can create a request where they are the sender
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      
      // READ: Anyone authenticated can read
      allow read: if request.auth != null;
      
      // UPDATE: Only the recipient or sender can update
      allow update: if request.auth != null && (
        (resource.data.to == request.auth.uid) ||
        (resource.data.from == request.auth.uid)
      );
      
      // DELETE: Only the sender or recipient can delete
      allow delete: if request.auth != null && 
                     (resource.data.from == request.auth.uid || 
                      resource.data.to == request.auth.uid);
    }
  }
}

// STORAGE RULES (if not already set)
service firebase.storage {
  match /b/{bucket}/o {
    
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
